[Unit]
Description=Резервна копія щодня о 03:30 за Києвом

[Timer]
# 03:30 — свідомо до ранкових прогонів: трекінг Maersk о 07:20, COSCO о 07:25,
# синхронізація з Експедитором о 07:45. Тобто копія знімається зі стану,
# який ще ніхто не чіпав цього дня.
OnCalendar=*-*-* 03:30:00
# Якщо сервер був вимкнений у момент запуску — виконати одразу після старту,
# а не чекати наступної доби.
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
