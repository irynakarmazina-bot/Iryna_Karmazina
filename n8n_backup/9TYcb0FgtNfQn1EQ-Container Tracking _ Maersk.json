    {
      "id": "node-build-report",
      "name": "Формуємо звіт",
      "parameters": {
        "jsCode": "\nconst items = $input.item.json.data || [];\nconst today = new Date().toLocaleDateString('uk-UA', { day:'2-digit', month:'2-digit', year:'numeric' });\nconst changedCount = items.filter(i => i['ETA Previous'] && i['ETA Current'] !== 'N/A' && i['ETA Previous'] !== i['ETA Current']).length;\n\nlet rows = '';\nfor (const c of items) {\n  const etaChanged = !!(c['ETA Previous'] && c['ETA Previous'] !== 'N/A' && c['ETA Current'] !== 'N/A' && c['ETA Previous'] !== c['ETA Current']);\n  const etaColor = etaChanged ? 'color:#c0392b;font-weight:bold' : '';\n  const etaIcon = etaChanged ? ' ⚠️' : '';\n  const hasTerminal = c['ETA Port'] && c['ETA Port'] !== 'N/A' && c['ETA Port'] !== c['ETA Current'];\n  rows += `<tr>\n    <td style=\"padding:9px 12px;border:1px solid #dee2e6\">${c['Container No'] || ''}</td>\n    <td style=\"padding:9px 12px;border:1px solid #dee2e6\">${c['Shipping Line'] || 'Maersk'}</td>\n    <td style=\"padding:9px 12px;border:1px solid #dee2e6\">${c['POD'] || ''}</td>\n    <td style=\"padding:9px 12px;border:1px solid #dee2e6\">${c['Vessel to POD'] || ''}</td>\n    <td style=\"padding:9px 12px;border:1px solid #dee2e6;color:#555\">${c['ETA Port'] || ''}</td>\n    <td style=\"padding:9px 12px;border:1px solid #dee2e6;${etaColor}\">${c['ETA Current'] || ''}${etaIcon}</td>\n    <td style=\"padding:9px 12px;border:1px solid #dee2e6\">${c['Status'] || ''}</td>\n  </tr>`;\n}\n\nconst html = `<div style=\"font-family:Arial,sans-serif;max-width:900px\">\n<h2 style=\"color:#1a3a5c;border-bottom:3px solid #1a3a5c;padding-bottom:8px\">📦 Тижневий звіт по контейнерах</h2>\n<p style=\"color:#666\">Дата: <b>${today}</b> &nbsp;|&nbsp; Контейнерів: <b>${items.length}</b>${changedCount > 0 ? ` &nbsp;|&nbsp; <span style=\"color:#c0392b\">ETA змінилась: ${changedCount}</span>` : ''}</p>\n<table style=\"width:100%;border-collapse:collapse;margin-top:12px\">\n<thead><tr style=\"background:#1a3a5c;color:white\">\n  <th style=\"padding:10px 12px;text-align:left;border:1px solid #1a3a5c\">Контейнер</th>\n  <th style=\"padding:10px 12px;text-align:left;border:1px solid #1a3a5c\">Лінія</th>\n  <th style=\"padding:10px 12px;text-align:left;border:1px solid #1a3a5c\">POD/Термінал</th>\n  <th style=\"padding:10px 12px;text-align:left;border:1px solid #1a3a5c\">Судно</th>\n  <th style=\"padding:10px 12px;text-align:left;border:1px solid #1a3a5c\">ETA Порт</th>\n  <th style=\"padding:10px 12px;text-align:left;border:1px solid #1a3a5c\">ETA Термінал</th>\n  <th style=\"padding:10px 12px;text-align:left;border:1px solid #1a3a5c\">Статус</th>\n</tr></thead>\n<tbody>${rows}</tbody>\n</table>\n<p style=\"color:#aaa;font-size:11px;margin-top:20px\">Автоматичний звіт системи трекінгу контейнерів Unitex HD</p>\n</div>`;\n\nreturn { json: { html, count: items.length, changedCount } };\n"
      },
