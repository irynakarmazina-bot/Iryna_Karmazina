    {
      "id": "node-parse",
      "name": "Парсимо відповідь",
      "parameters": {
        "jsCode": "const api = $input.item.json;\nconst row = $('Тільки Maersk').item.json;\n\nconst containerNo = row['Container No'] || '';\nconst prevEta = row['ETA Current'] || '';\nconst rowNum = row['row_number'] || 2;\n\nconst events = api.events || [];\n\nif (events.length === 0) {\n  return { json: { containerNo, rowNum, prevEta, pod: 'N/A', vessel: 'N/A', etaPort: 'N/A', eta: 'N/A', status: 'Немає даних', etaChanged: false } };\n}\n\nfunction getLoc(e) {\n  if (!e) return '';\n  return (e.transportCall && e.transportCall.location && e.transportCall.location.locationName)\n    || (e.transportCall && e.transportCall.UNLocationCode)\n    || '';\n}\n\nconst transportEvents = events.filter(e => e.eventType === 'TRANSPORT');\nconst equipEvents     = events.filter(e => e.eventType === 'EQUIPMENT');\n\n// --- ETA PORT: first EST/PLN ARRI, fallback to last DISC ---\nconst transportArriEst = transportEvents\n  .filter(e => e.transportEventTypeCode === 'ARRI' && (e.eventClassifierCode === 'EST' || e.eventClassifierCode === 'PLN'))\n  .sort((a, b) => new Date(a.eventDateTime) - new Date(b.eventDateTime));\n\nconst discEvents = equipEvents\n  .filter(e => e.equipmentEventTypeCode === 'DISC')\n  .sort((a, b) => new Date(a.eventDateTime) - new Date(b.eventDateTime));\n\nconst etaPortEvent = transportArriEst[0] || discEvents[discEvents.length - 1] || null;\nconst etaPort = etaPortEvent ? etaPortEvent.eventDateTime.substring(0, 10) : 'N/A';\n\n// --- ETA TERMINAL: last EST/PLN ARRI, fallback to last GTIN ---\nconst gtinEvents = equipEvents\n  .filter(e => e.equipmentEventTypeCode === 'GTIN')\n  .sort((a, b) => new Date(a.eventDateTime) - new Date(b.eventDateTime));\n\nconst etaTerminalEvent = transportArriEst[transportArriEst.length - 1]\n  || gtinEvents[gtinEvents.length - 1]\n  || etaPortEvent\n  || null;\n\nconst eta = etaTerminalEvent ? etaTerminalEvent.eventDateTime.substring(0, 10) : 'N/A';\n\n// --- POD ---\nconst pod = getLoc(etaTerminalEvent) || 'N/A';\n\n// --- VESSEL: real vessel name (ignore DUMMY BARGE) ---\nconst vesselEvent = [...transportEvents, ...equipEvents].find(e =>\n  e.transportCall && e.transportCall.vessel &&\n  e.transportCall.vessel.vesselName &&\n  e.transportCall.vessel.vesselName !== 'DUMMY BARGE'\n);\nconst vessel = (vesselEvent && vesselEvent.transportCall.vessel.vesselName) || 'N/A';\n\n// --- STATUS: latest event by date, user-friendly labels ---\nconst latestEvent = [...events].sort((a, b) =>\n  new Date(b.eventDateTime) - new Date(a.eventDateTime)\n)[0];\n\nlet status = 'В дорозі';\nif (latestEvent) {\n  const eq = latestEvent.equipmentEventTypeCode;\n  const tr = latestEvent.transportEventTypeCode;\n  const sh = latestEvent.shipmentEventTypeCode;\n  const cls = latestEvent.eventClassifierCode; // ACT, EST, PLN\n\n  if (eq === 'LOAD') {\n    status = 'На судні';\n  } else if (eq === 'DISC') {\n    const loc = getLoc(latestEvent);\n    status = loc ? `Розвантажено: ${loc}` : 'Розвантажено в порту';\n  } else if (eq === 'GTIN') {\n    const loc = getLoc(latestEvent);\n    status = loc ? `На терміналі: ${loc}` : 'На терміналі';\n  } else if (eq === 'GTOT') {\n    status = 'Покинув термінал';\n  } else if (tr === 'ARRI') {\n    const loc = getLoc(latestEvent);\n    if (cls === 'ACT') {\n      status = loc ? `Прибуло: ${loc}` : 'Прибуло';\n    } else {\n      status = loc ? `Очікується: ${loc}` : 'Очікується прибуття';\n    }\n  } else if (tr === 'DEPA') {\n    status = 'Відправлено';\n  } else if (sh === 'PENA') {\n    status = 'Оформлення документів';\n  } else if (sh === 'RELS') {\n    status = 'Підготовлено до відправки';\n  }\n}\n\nconst etaChanged = !!(prevEta && prevEta !== 'N/A' && eta !== 'N/A' && prevEta !== eta);\n\nreturn { json: { containerNo, rowNum, prevEta, pod, vessel, etaPort, eta, status, etaChanged } };",
        "mode": "runOnceForEachItem"
      },
      "position": [
        1344,
        304
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
