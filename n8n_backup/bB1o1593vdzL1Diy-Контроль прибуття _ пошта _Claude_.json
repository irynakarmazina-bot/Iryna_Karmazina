      "id": "636f3e4b-1d0a-40d9-b96d-1b580704c096",
      "name": "Фільтр: номер + дедуп",
      "parameters": {
        "jsCode": "\nconst sd=$getWorkflowStaticData('global'); sd.seen=sd.seen||{};\nif(Object.keys(sd.seen).length>8000) sd.seen={};\nconst j=$json;\nconst id=String(j.messageId||j.uid||(String(j.subject||'')+'|'+String(j.date||'')));\nif(sd.seen[id]) return [];\nconst subj=String(j.subject||''); const body=String(j.textPlain||j.text||j.textHtml||'');\nconst hay=subj+' '+body;\nconst hasId=/[A-Z]{4}\\d{6,7}/.test(hay)||/\\b\\d{9}\\b/.test(hay)||/MEDU\\w{6,}/i.test(hay)||/NBXT\\w+/i.test(hay);\nif(!hasId) return [];\nsd.seen[id]=1;\nreturn [{json:{subject:subj, from:String(j.from||''), date:String(j.date||''), text:body}}];\n"
      },
      "position": [
        240,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
