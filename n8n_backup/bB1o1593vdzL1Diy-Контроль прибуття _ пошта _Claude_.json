    {
      "id": "8ceec5aa-ff73-404e-a53a-bf64a58dccd0",
      "name": "Порівняння + рядок",
      "parameters": {
        "jsCode": "\nconst n=$('Розбір Claude').item.json;\nconst old=($json && $json['BL/Booking'])?$json:null;\nconst T=new Date().toISOString().slice(0,10);\nif(!old){ return [{json:{_matched:false,'Дата':T,'BL/Booking':n.bl_booking,'Контейнер':n.container,'Статус (з листа)':n.status,'ETA (з листа)':n.eta,'Лист (джерело)':n.email_ref}}]; }\nconst out={_matched:true,'BL/Booking':n.bl_booking,'Останнє оновлення':T,'Лист (джерело)':n.email_ref};\nif(n.status) out['Статус']=n.status;\nif(n.container && !(old['Контейнер']||'').trim()) out['Контейнер']=n.container;\nif(n.vessel) out['Судно']=n.vessel;\nif(n.eta){ out['ETA порт (план)']=n.eta; const o=(old['ETA порт (план)']||'').trim();\n  if(o && o!==n.eta){ const h=(old['Зміни ETA (історія)']||''); out['Зміни ETA (історія)']=(h?h+'\\n':'')+T+': ETA порт: '+o+' → '+n.eta+' (пошта)'; out['Остання зміна']=T; } }\nreturn [{json:out}];\n"
      },
