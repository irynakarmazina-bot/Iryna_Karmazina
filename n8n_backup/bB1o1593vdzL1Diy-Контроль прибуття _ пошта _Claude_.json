      "name": "Розбір Claude",
      "parameters": {
        "jsCode": "\nconst raw=($json.content&&$json.content[0]&&$json.content[0].text)||'{}';\nlet d; try{ d=JSON.parse(raw);}catch(e){return [];}\nif(!d||d.has_data===false) return [];\nconst m=$('Запит до Claude').item.json;\nconst bl=(d.bl_booking||'').trim();\nif(!bl) return [];\nreturn [{json:{bl_booking:bl, container:(d.container||'').trim(), order_no:(d.order_no||'').trim(),\n  eta:(d.eta||'').trim(), status:(d.status||'').trim(), vessel:(d.vessel||'').trim(),\n  email_ref:(m._subject||'')+' | '+(m._from||'')+' | '+(m._date||'')}}];\n"
      },
