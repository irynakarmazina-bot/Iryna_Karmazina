    {
      "id": "d559264e-e6ae-44f7-9e61-4f23323c617e",
      "name": "Відбір Maersk",
      "parameters": {
        "jsCode": "\nconst out=[];\nfor(const it of $input.all()){ const r=it.json;\n  const bl=String(r['BL/Booking']||'').trim();\n  if(!/^\\d{9}$/.test(bl)) continue;\n  out.push({json:{bl, ourContainer:String(r['Контейнер']||'').trim(),\n    etaPlanOld:String(r['ETA порт (план)']||'').trim(), histOld:String(r['Зміни ETA (історія)']||''),\n    curStatus:String(r['Статус']||'').trim()}});\n}\nreturn out;\n"
      },
      "position": [
        660,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "79506c17-7abc-4a0e-88c1-5a826b1d48b5",
      "name": "Maersk API",
      "parameters": {
        "headerParameters": {
          "parameters": [
            {
              "name": "Consumer-Key",
              "value": "euoSpwATjMpLeIlp6wcnFRtt9dG4i6Gg"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Maersk Token').first().json.access_token }}"
            }
          ]
        },
        "method": "GET",
        "options": {
          "batching": {
            "batch": {
              "batchInterval": 1500,
              "batchSize": 8
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendHeaders": true,
        "url": "={{ 'https://api.maersk.com/track-and-trace-private/events?carrierBookingReference=' + encodeURIComponent($json.bl) }}"
      },
      "position": [
        880,
        0
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "c8cec335-7ec5-408f-af22-c1a547e96434",
      "name": "Розбір",
      "parameters": {
        "jsCode": "const metas=$('Відбір Maersk').all().map(x=>x.json);\nconst items=$input.all();\nconst today=new Date(); today.setHours(0,0,0,0); const T=today.toISOString().slice(0,10);\nconst byDate=a=>a.sort((x,y)=>String(x.eventDateTime).localeCompare(String(y.eventDateTime)));\nconst results=[];\nfor(let i=0;i<items.length;i++){\n  const meta=metas[i]||{};\n  const resp=items[i].json; const body=resp.body!==undefined?resp.body:resp;\n  const events=(body&&body.events)?body.events:null;\n  if(!events) continue;\n  const out={'BL/Booking':meta.bl,'Лінія':'Maersk','Останнє оновлення':T};\n  const conts=[...new Set(events.map(e=>e.equipmentReference).filter(Boolean))];\n  out['Контейнер (лінія)']=conts.join(', ');\n  if(!meta.ourContainer && conts.length) out['Контейнер']=conts[0];\n  out['Звірка']='';\n  if(meta.ourContainer && conts.length && !conts.includes(meta.ourContainer)) out['Звірка']='За Maersk: '+conts.join(', ');\n  const ves=byDate(events.filter(e=>((e.transportCall||{}).modeOfTransport)==='VESSEL'));\n  const last=ves.length?ves[ves.length-1]:null;\n  const arr=byDate(events.filter(e=>(e.transportEventTypeCode==='ARRI'||e.equipmentEventTypeCode==='ARRI')));\n  const lastArr=arr.length?arr[arr.length-1]:null;\n  let etaIso='',act=false;\n  if(lastArr){ etaIso=String(lastArr.eventDateTime).slice(0,10); act=(lastArr.eventClassifierCode==='ACT'); }\n  let days=999; if(etaIso){ const e=new Date(etaIso); e.setHours(0,0,0,0); days=Math.round((e-today)/86400000); }\n  if(last && days<=7){ const tc=last.transportCall||{};\n    out['Судно']=(tc.vessel||{}).vesselName||'';\n    out['Вояж']=tc.carrierVoyageNumber||tc.exportVoyageNumber||tc.importVoyageNumber||''; }\n  if(etaIso){\n    if(act){ out['ETA порт (факт)']=etaIso; }\n    else { out['ETA порт (план)']=etaIso;\n      if(meta.etaPlanOld && meta.etaPlanOld!==etaIso){\n        out['Зміни ETA (історія)']=(meta.histOld?meta.histOld+'\\n':'')+T+': ETA порт: '+meta.etaPlanOld+' → '+etaIso+' (Maersk)';\n        out['Остання зміна']=T; } } }\n  // --- Статус: 8-модель, «Завантажений» РОЗДІЛЕНО на авто/потяг за видом транспорту ---\n  const all=byDate(events.slice()); const le=all[all.length-1];\n  const mode=((le.transportCall||{}).modeOfTransport)||'';\n  const c2=le.equipmentEventTypeCode||le.transportEventTypeCode||le.shipmentEventTypeCode||'';\n  const isVes=(mode==='VESSEL'||mode==='');\n  const loadSt=(mode==='RAIL')?'Завантажений на потяг':'Завантажений на авто';\n  let st='';\n  if(c2==='LOAD'||c2==='DEPA') st=isVes?'В морі':loadSt;\n  else if(c2==='ARRI') st=(mode==='VESSEL')?'В морі':loadSt;\n  else if(c2==='DISC') st=(mode==='VESSEL'||!mode)?'Вивантажений в порту прибуття':loadSt;\n  else if(c2==='GTOT') st=loadSt;\n  else if(c2==='GTIN') st=(mode==='TRUCK')?'Вантаж доставлено':loadSt;\n  if(st && meta.curStatus!=='Вантаж доставлено') out['Статус']=st;  // «Доставлено» заморожено\n  results.push({json:out});\n}\nreturn results;\n"
      },
