    {
      "id": "b0ecdd63-02b9-4afc-b57b-f8dc0ae4b84c",
      "name": "Мапінг",
      "parameters": {
        "jsCode": "const rows = $('Читаємо Відправлення').all().map(i=>i.json).filter(r=>String(r['Угода']||'').trim());\nconst existing = $('Наявні в NocoDB').all().flatMap(i=>i.json.list||[]);\nconst byDeal = {}; existing.forEach(r=>{ byDeal[String(r['Угода']||'').trim()] = r.Id; });\nconst dm = v => { const m = String(v==null?'':v).match(/(\\d{4})-(\\d{2})-(\\d{2})/); return m ? m[0] : null; };\nconst yn = v => /так/i.test(String(v||''));\nconst STAT = new Set(['Букінг','Стафіровка','В порту відправлення','Завантажений на судно','В морі','Вивантажений в порту прибуття','Завантажений на авто/потяг','Вантаж доставлено']);\nconst DATES = ['Подача авто (план)','Подача авто (факт)','Port Cut Off','Гейт ін','ETD (план)','ETD (факт)','ETA порт (план)','ETA порт (факт)','Вивантаження в порту (факт)','Постановка/завантаження (план)','Постановка/завантаження (факт)','Перетин кордону (факт)','Планова до клієнта (план)','Планова до клієнта (факт)','Вивантаження у отримувача (факт)'];\nconst TEXTS = ['Тип','Перевізник','Агент','Маршрут','Вояж','Контейнер (лінія)','Звірка','Сухий порт','Адреса розмитнення','Тип обладнання','Кількість','Вивіз (Carrier/Merchant)','Номер авто','Номер ЦМР','Водій (ПІБ)','Водій (телефон)','Остання зміна','Останнє оновлення','Лист (джерело)'];\nconst LONGS = ['Зміни ETA (історія)','Коментар клієнту'];\nconst toInsert=[], toUpdate=[];\nrows.forEach(r=>{\n  const o = {\n    'Угода': String(r['Угода']).trim(),\n    'Клієнт': r['Клієнт']||null,\n    'BL': r['BL/Booking']||null,\n    'Контейнер': r['Контейнер']||null,\n    'Судно': r['Судно']||null,\n    'ETA': dm(r['ETA порт (факт)']) || dm(r['ETA порт (план)']),\n    'Коментар': r['Коментар внутрішній']||null,\n    'Телекс': yn(r['Телекс-реліз']),\n    'Т1': yn(r['T1']!==undefined?r['T1']:r['Т1']),\n    'Реліз': yn(r['Реліз'])\n  };\n  DATES.forEach(k=>{ o[k] = dm(r[k]); });\n  TEXTS.forEach(k=>{ o[k] = (r[k]===undefined||r[k]===null||String(r[k]).trim()==='') ? null : String(r[k]); });\n  LONGS.forEach(k=>{ o[k] = (r[k]===undefined||r[k]===null||String(r[k]).trim()==='') ? null : String(r[k]); });\n  const dir=String(r['Напрямок']||'').trim(); if(['Імпорт','Експорт','Транзит'].includes(dir)) o['Напрямок']=dir;\n  const line=String(r['Лінія']||'').trim(); if(['Maersk','MSC','CMA CGM','Інша'].includes(line)) o['Лінія']=line;\n  const st=String(r['Статус']||'').trim(); if(STAT.has(st)) o['Статус']=st;\n  const id=byDeal[o['Угода']];\n  if(id) toUpdate.push(Object.assign({Id:id}, o)); else toInsert.push(o);\n});\nconst CH=25, out=[];\nfor(let i=0;i<toInsert.length;i+=CH) out.push({json:{method:'POST', records: toInsert.slice(i,i+CH)}});\nfor(let i=0;i<toUpdate.length;i+=CH) out.push({json:{method:'PATCH', records: toUpdate.slice(i,i+CH)}});\nreturn out.length ? out : [{json:{method:'NONE', records:[]}}];",
        "mode": "runOnceForAllItems"
      },
