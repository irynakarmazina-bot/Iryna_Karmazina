    {
      "id": "0426fc0e-9c7b-4f59-9455-a1119839715c",
      "name": "Нові для таблиці",
      "parameters": {
        "jsCode": "const nc = $('Угоди з платформи').all().flatMap(i=>i.json.list||[]);\nconst sheet = $('Читаємо Відправлення').all().map(i=>i.json);\nconst norm = v => { const s=String(v==null?'':v).trim(); return /^\\d+$/.test(s)? String(parseInt(s,10)) : s; };\nconst inSheet = new Set(sheet.map(r=>norm(r['Угода'])).filter(Boolean));\nconst padded = sheet.some(r=>/^0\\d{5,}$/.test(String(r['Угода']||'').trim()));\nconst padLen = padded ? String(sheet.find(r=>/^0\\d{5,}$/.test(String(r['Угода']||'').trim()))['Угода']).trim().length : 0;\nconst out = [];\nnc.forEach(r=>{\n  const n = norm(r['Угода']); if(!n || inSheet.has(n)) return;\n  out.push({json:{\n    'Угода': padded ? String(n).padStart(padLen,'0') : String(n),\n    'Клієнт': r['Клієнт']||'',\n    'Лінія': r['Лінія']||'',\n    'BL/Booking': r['BL']||'',\n    'Напрямок': r['Напрямок']||''\n  }});\n});\nreturn out;",
        "mode": "runOnceForAllItems"
      },
